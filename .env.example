# Sagar Drishti (सागर दृष्टि) — Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS AND PREFERENCES.
# NEVER COMMIT THE ACTUAL .env FILE OR SECRETS TO VERSION CONTROL.

# ==============================================================================
# Database Configuration (MongoDB Atlas / Local)
# ==============================================================================
# Connection URI for MongoDB Atlas or local MongoDB instance
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Target database name
MONGODB_DB_NAME=sagar_drishti

# ==============================================================================
# NOAA OISST v2.1 ERDDAP Data Source Configuration
# ==============================================================================
# Base URL for NOAA CoastWatch ERDDAP server
ERDDAP_BASE_URL=https://coastwatch.pfeg.noaa.gov/erddap

# ERDDAP Dataset ID (ncdcOisst21NrtAgg_LonPM180 has longitudes -180..180 matching Indian Ocean app convention)
ERDDAP_DATASET_ID=ncdcOisst21NrtAgg_LonPM180

# HTTP request timeout in seconds for ERDDAP data queries
ERDDAP_TIMEOUT_SECONDS=90

# ==============================================================================
# Regional Bounding Box Settings (Indian Ocean)
# ==============================================================================
REGION_MIN_LAT=-30.0
REGION_MAX_LAT=30.0
REGION_MIN_LON=30.0
REGION_MAX_LON=120.0

# ==============================================================================
# Data Pipeline, Latency & Stale Thresholds
# ==============================================================================
# Expected data latency in days before data is marked 'cached' instead of 'live' (default: 3)
EXPECTED_LATENCY_DAYS=3

# Threshold in days from current UTC date after which data is marked 'stale' (default: 3)
STALE_THRESHOLD_DAYS=3

# Maximum retention window in days for stored live SST grids (default: 180)
# Older live records beyond this window are automatically purged. Seed data is never deleted.
RETENTION_WINDOW_DAYS=180

# Maximum missing historical days backfilled per ingestion run (default: 7)
MAX_BACKFILL_DAYS_PER_RUN=7

# Distributed MongoDB lock expiry duration in seconds (default: 1800 = 30 minutes)
INGEST_LOCK_TTL_SECONDS=1800

# Minimum stored history days required to compute secondary rolling baseline anomalies (default: 30)
MIN_HISTORY_DAYS=30

# Ingestion refresh interval in hours
REFRESH_INTERVAL_HOURS=24

# ==============================================================================
# Server & Optional Scheduler Settings
# ==============================================================================
# API Host and Port
HOST=127.0.0.1
PORT=8000

# Toggle optional background ingestion scheduler loop inside FastAPI (default: false)
# Set to 'true' only if you want the backend process to run scheduled ingestion internally.
ENABLE_BACKEND_SCHEDULER=false
